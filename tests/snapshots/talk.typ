  secondary: rgb("#6F92B0"), accent: rgb("#C8944E"),
  background: rgb("#F7F8FA"), surface: rgb("#ECF0F5"),
  text: rgb("#141C26"), text-muted: rgb("#5A6672"), border: rgb("#D6DDE6"),
)

