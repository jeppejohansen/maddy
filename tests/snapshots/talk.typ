// text-size presets set the body; every other level follows the style's scale.
#let sizes = (small: 18pt, medium: 21pt, large: 24pt)

// Ratios control geometry only; no style has a per-ratio variant.
#let ratios = (
  "16:9": (width: 841.89pt, height: 473.56pt),
  "3:2":  (width: 841.89pt, height: 561.26pt),
  "4:3":  (width: 841.89pt, height: 631.42pt),
)

// ============================================================ composition

// The active configuration, set once by `presentation` and read by each slide.
#let maddy-config = state("maddy-config", none)
#let maddy-slide-no = counter("maddy-slide")

#let resolve(style: "modern", palette: "midnight", ratio: "16:9", text-size: "medium",
             deck-title: "") = (
  style: styles.at(style),
  palette: palettes.at(palette),
  body: if type(text-size) == length { text-size } else { sizes.at(text-size) },
  geo: ratios.at(ratio),
  deck-title: deck-title,
)

// One typographic level, resolved to concrete text arguments.
#let lvl(c, level) = {
  let t = c.style.type.at(level)
  (font: t.family, weight: t.weight, size: c.body * t.scale, tracking: t.tracking)
}

#let txt(c, level, fill: none, body) = {
  let a = lvl(c, level)
  let styled = text(font: a.font, weight: a.weight, size: a.size, tracking: a.tracking,
                    fill: if fill == none { c.palette.text } else { fill }, body)
  // Large type needs its own leading; the body's would open a chasm between
  // two lines of a title.
  if level == "display" or level == "title" {
    par(leading: c.style.display-leading, styled)
  } else { styled }
}

#let eyebrow(c, body) = block(below: 0.8em,
  txt(c, "eyebrow", fill: c.palette.accent, upper(body)))

// Markers are sized relative to the body and nudged onto the optical centre.
// A marker left at full body size reads as content rather than punctuation.
#let marker-for(c) = {
  let p = c.palette
  let m = c.style.marker
  if m == "square" { box(baseline: -0.24em, text(size: 0.40em, fill: p.accent, [■])) }
  else if m == "rule" { box(baseline: -0.30em, width: 0.6em, line(length: 100%, stroke: 1.2pt + p.secondary)) }
  else if m == "chevron" { box(baseline: -0.02em, text(size: 0.68em, fill: p.accent, font: "IBM Plex Mono", [>])) }
  else { box(baseline: -0.10em, text(size: 0.68em, fill: p.accent, [•])) }
}

// Everything a slide body needs: typography, lists, equations, code, tables,
// quotes, links and images.
#let maddy-rules(c, body) = {
  let p = c.palette
  let s = c.style
  set text(..lvl(c, "body"), fill: p.text, lang: "en")
  set par(leading: s.leading, spacing: s.par-spacing, justify: false)
  set block(spacing: s.par-spacing)

  show math.equation: set text(font: "New Computer Modern Math")
  show math.equation.where(block: true): set block(above: 1.2em, below: 1.2em)

  set list(indent: 0.35em, spacing: s.par-spacing * 0.80, marker: marker-for(c))
  set enum(indent: 0.35em, spacing: s.par-spacing * 0.80)

  show heading.where(level: 2): it => block(above: 1.15em, below: 0.4em,
    txt(c, "h2", fill: p.primary, it.body))
  show heading.where(level: 3): it => block(above: 0.95em, below: 0.3em,
    txt(c, "h3", fill: p.text, it.body))
  show heading.where(level: 4): it => block(above: 0.85em, below: 0.25em,
    txt(c, "h3", fill: p.text-muted, it.body))

  show raw: set text(..lvl(c, "code"))
  show raw.where(block: true): it => block(width: 100%, fill: p.surface,
    inset: (x: 0.9em, y: 0.8em), stroke: (left: 2pt + p.secondary), it)

  set table(stroke: none, inset: (x: 0.75em, y: 0.55em))
  show table.cell.where(y: 0): set text(weight: 650, fill: p.primary)
  show table: it => block(above: 1.1em, below: 1.1em, it)

  show quote.where(block: true): it => block(width: 100%, inset: (left: 1em, y: 0.25em),
    stroke: (left: 2pt + p.accent), text(fill: p.text, it.body))

  show link: set text(fill: p.primary, weight: 500)
  // Images are constrained to the slide rather than allowed to overflow it.
  show image: it => align(center, box(width: 100%, it))
  body
}

#let maddy-page(c, footer: true) = (
  width: c.geo.width, height: c.geo.height, fill: c.palette.background,
  margin: (
    x: c.geo.width * c.style.margin.x,
    top: c.geo.height * c.style.margin.top,
    bottom: c.geo.height * c.style.margin.bottom,
  ),
  footer: if footer {
    context {
      let n = maddy-slide-no.get().first()
      let a = lvl(c, "caption")
      set text(font: a.font, size: a.size, fill: c.palette.text-muted)
      grid(columns: (1fr, auto), align(left, c.deck-title), align(right, str(n)))
    }
  } else { none },
)

// ============================================================ the contract
//
// The renderer applies `presentation` with a show rule, then calls
// `title-slide` once if the document has a title, then `slide` per slide.
// Nothing above this file knows what any of them do.

#let presentation(
  style: "modern", palette: "midnight", ratio: "16:9", text-size: "medium",
  title: none, subtitle: none, author: none, date: none,
  body,
) = {
  let c = resolve(style: style, palette: palette, ratio: ratio, text-size: text-size,
                  deck-title: if title != none { title } else { "" })
  maddy-config.update(c)

  set document(
    title: if title != none { title } else { "" },
    author: if author != none { (author,) } else { () },
  )
  set page(..maddy-page(c))
  show: maddy-rules.with(c)
  body
}

#let title-slide(title: none, subtitle: none, author: none, date: none) = context {
  let c = maddy-config.get()
  let p = c.palette
  page(
    ..maddy-page(c, footer: false),
    margin: (x: c.geo.width * c.style.margin.x, y: c.geo.height * 0.15),
  )[
    #show: maddy-rules.with(c)
    #align(horizon + left)[
      #block(below: if subtitle != none { 0.55em } else { 0.95em },
        txt(c, "display", fill: p.primary, title))
      #if subtitle != none {
        block(below: 1.6em, txt(c, "h3", fill: p.text-muted, subtitle))
      }
      #block(above: 0.2em, line(length: 20%, stroke: 1.2pt + p.accent))
      #if author != none {
        block(above: 1.35em, below: 0.25em, txt(c, "body", fill: p.text, author))
      }
      #if date != none { txt(c, "caption", fill: p.text-muted, date) }
    ]
  ]
}

#let slide(title: none, body) = context {
  let c = maddy-config.get()
  let p = c.palette
  page(..maddy-page(c))[
    // Stepped inside the page: stepping it outside places content in the
    // surrounding flow, which emits a blank page before every slide.
    #maddy-slide-no.step()
    #show: maddy-rules.with(c)
    #if title != none {
      block(
        width: 100%, below: c.style.title-gap,
        stroke: if c.style.title-rule { (bottom: c.style.rule + p.border) } else { none },
        inset: if c.style.title-rule { (bottom: 0.4em) } else { (bottom: 0em) },
        txt(c, "title", fill: p.primary, title),
      )
      // `bold` marks a title with a short heavy rule rather than a hairline.
      if c.style.name == "bold" {
        block(above: -0.85em, below: 1.05em, line(length: 8%, stroke: c.style.rule + p.accent))
      }
    }
    #block(width: c.style.measure * 100%, body)
  ]
}

#show: presentation.with(
  style: "academic",
  palette: "midnight",
  ratio: "16:9",
  text-size: "medium",
  title: "Peer Effects",
  subtitle: "High School Application",
  author: "Jane Researcher",
)

#title-slide(
  title: "Peer Effects",
  subtitle: "High School Application",
  author: "Jane Researcher",
)

#slide(title: [Motivation])[
  Students make educational decisions in social environments.

  - Friends share information
  - Choices may be strategic complements
  - Policy can change peer composition
]

#slide(title: [Model])[
  Student $i$ chooses

  $ a_i ∈ { 0 , 1 } . $

  Application probability is

  $ p_i = op("logit")^(-1) lr(\( X_i^⊤ β + λ macron(p)_(-i) \)) . $
]

#slide(title: [Policy experiment])[
  Suppose a GPA cutoff is introduced.

  The direct effect changes eligibility.

  The equilibrium effect additionally changes peer behavior.
]

#slide(title: [Results])[
  #table(
    columns: 2,
    align: (auto, right),
